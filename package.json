{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "Task Management Dashboard - Senior Angular assignment",
  "scripts": {
    "ng": "ng",
    "generate:data": "node data-generator/generate-data.js",
    "db": "node mock-server/build-db.mjs",
    "api": "json-server --watch mock-server/db.json --routes mock-server/routes.json --port 3000 --delay 400",
    "preapi": "node mock-server/build-db.mjs",
    "start": "npm run generate:data && concurrently -k -n api,web -c magenta,cyan \"npm:api\" \"npm:serve\"",
    "serve": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"*.{json,md}\" \"mock-server/**/*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.21.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "chart.js": "^4.6.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^21.4.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.0",
    "jsdom": "^28.0.0",
    "json-server": "^0.17.4",
    "lint-staged": "^16.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,md,mjs}": "prettier --write"
  }
}
